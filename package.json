{
  "name": "yun-vscode-tools",
  "displayName": "Yun VSCode Tools",
  "description": "Yun 的 VS Code/Cursor 开发辅助工具合集",
  "version": "0.0.1",
  "publisher": "liuyundev",
  "icon": "resources/logo.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yun8711/yun-vscode-tools.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:yunVscodeTools.revealActiveFile",
    "onCommand:yunVscodeTools.disableExplorerAutoReveal",
    "onCommand:yunVscodeTools.copyFile",
    "onCommand:yunVscodeTools.editCommitMessage",
    "onCommand:yunVscodeTools.compressResources",
    "onCommand:yunVscodeTools.compressChildren"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "yunVscodeTools.revealActiveFile",
        "title": "定位当前文件",
        "category": "Yun VSCode Tools",
        "icon": "$(target)"
      },
      {
        "command": "yunVscodeTools.disableExplorerAutoReveal",
        "title": "关闭资源管理器自动定位",
        "category": "Yun VSCode Tools"
      },
      {
        "command": "yunVscodeTools.copyFile",
        "title": "复制文件",
        "category": "Yun VSCode Tools",
        "icon": "$(copy)"
      },
      {
        "command": "yunVscodeTools.editCommitMessage",
        "title": "编辑提交消息",
        "category": "Yun VSCode Tools",
        "icon": "$(edit)"
      },
      {
        "command": "yunVscodeTools.compressResources",
        "title": "压缩",
        "category": "Yun VSCode Tools",
        "icon": "$(file-zip)"
      },
      {
        "command": "yunVscodeTools.compressChildren",
        "title": "压缩子文件",
        "category": "Yun VSCode Tools",
        "icon": "$(file-zip)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "yunVscodeTools.revealActiveFile",
          "when": "view == workbench.explorer.fileView",
          "group": "navigation@90"
        }
      ],
      "explorer/context": [
        {
          "command": "yunVscodeTools.copyFile",
          "when": "resourceScheme == file && !explorerResourceIsFolder",
          "group": "yun@1"
        },
        {
          "command": "yunVscodeTools.editCommitMessage",
          "when": "resourceScheme == file",
          "group": "yun@2"
        },
        {
          "command": "yunVscodeTools.compressResources",
          "when": "resourceScheme == file",
          "group": "yun@3"
        },
        {
          "command": "yunVscodeTools.compressChildren",
          "when": "resourceScheme == file && explorerResourceIsFolder",
          "group": "yun@4"
        }
      ]
    }
  },
  "scripts": {
    "compile": "pnpm run compile:helper && tsc -p ./",
    "compile:helper": "mkdir -p bin && clang -framework AppKit -o bin/yun-copy-files-macos native/macos-copy-files.m",
    "watch": "tsc -watch -p ./",
    "package": "pnpm run compile && vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.3",
    "@vscode/vsce": "^2.15.0"
  }
}
